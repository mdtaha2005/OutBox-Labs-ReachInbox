datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum EmailStatus {
  PENDING
  QUEUED
  PROCESSING
  SENT
  FAILED
  RESCHEDULED
  CANCELLED
}

model User {
  id            String          @id @default(uuid())
  googleId      String          @unique
  email         String          @unique
  name          String
  avatarUrl     String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  senderAccounts SenderAccount[]
  campaigns      Campaign[]
  emails         EmailRecord[]

  @@index([email])
}

model SenderAccount {
  id            String          @id @default(uuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  email         String
  displayName   String?
  smtpHost      String          @default("smtp.ethereal.email")
  smtpPort      Int             @default(587)
  smtpUser      String
  smtpPass      String
  isDefault     Boolean         @default(false)
  hourlyLimit   Int             @default(200)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  campaigns     Campaign[]
  emails        EmailRecord[]

  @@unique([userId, email])
  @@index([userId])
}

model Campaign {
  id                 String          @id @default(uuid())
  userId             String
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  senderAccountId    String
  senderAccount      SenderAccount   @relation(fields: [senderAccountId], references: [id], onDelete: Restrict)
  
  name               String?
  subject            String
  body               String          @db.Text
  totalLeads         Int
  delaySeconds       Int             @default(2)
  hourlyLimit        Int             @default(200)
  scheduledStartTime DateTime
  
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  emails             EmailRecord[]

  @@index([userId])
  @@index([senderAccountId])
}

model EmailRecord {
  id                 String          @id @default(uuid())
  campaignId         String
  campaign           Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId             String
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  senderAccountId    String
  senderAccount      SenderAccount   @relation(fields: [senderAccountId], references: [id], onDelete: Restrict)

  recipientEmail     String
  subject            String
  body               String          @db.Text
  
  scheduledAt        DateTime
  actualScheduledAt  DateTime
  sentAt             DateTime?
  
  status             EmailStatus     @default(QUEUED)
  bullMqJobId        String?         @unique
  
  etherealMessageId  String?
  etherealPreviewUrl String?
  
  retryCount         Int             @default(0)
  errorMessage       String?         @db.Text
  
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([userId, status])
  @@index([senderAccountId, status])
  @@index([actualScheduledAt, status])
  @@index([bullMqJobId])
}